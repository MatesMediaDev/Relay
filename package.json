{
  "name": "kitsu",
  "version": "0.3.16",
  "private": true,
  "author": "ExcaliburAU",
  "description": "Kitsu — lean themeable Matrix desktop client with plugins",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "desktop:start": "electron .",
    "build:icons": "python scripts/generate-icons.py",
    "build:markdown": "node scripts/build-markdown.mjs",
    "build:livekit": "node scripts/build-livekit.mjs",
    "build:matrix-browser": "node scripts/build-browser-matrix.mjs",
    "build:vendor": "node scripts/build-markdown.mjs && node scripts/build-livekit.mjs && node scripts/build-browser-matrix.mjs",
    "streamdeck:validate": "node streamdeck-plugin/validate.js",
    "streamdeck:build": "node streamdeck-plugin/build.js",
    "streamdeck:install": "node streamdeck-plugin/install-linux.js",
    "mobile:sync": "npm --prefix mobile run sync",
    "mobile:apk": "npm run build:matrix-browser && npm --prefix mobile run build:apk",
    "postinstall": "node scripts/build-markdown.mjs && node scripts/build-livekit.mjs",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:all": "electron-builder --win nsis --linux AppImage"
  },
  "dependencies": {
    "abstract-level": "^1.0.4",
    "classic-level": "^1.4.1",
    "express": "^4.21.2",
    "level": "^8.0.1",
    "level-supports": "^4.0.1",
    "level-transcoder": "^1.0.1",
    "livekit-client": "^2.20.0",
    "matrix-js-sdk": "^37.5.0",
    "node-indexeddb": "^6.0.3",
    "prismjs": "^1.30.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "electron": "^32.3.2",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "dev.exau.kitsu",
    "productName": "Kitsu",
    "copyright": "Copyright © ExcaliburAU",
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "assets/**/*",
      "plugins/**/*",
      "server.js",
      "package.json",
      "README.md",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node-indexeddb/**",
      "**/level/**",
      "**/classic-level/**",
      "**/abstract-level/**",
      "**/level-supports/**",
      "**/level-transcoder/**",
      "**/browser-level/**",
      "**/node-gyp-build/**",
      "**/catering/**",
      "**/module-error/**",
      "**/queue-microtask/**",
      "**/is-buffer/**",
      "**/buffer/**",
      "**/base64-js/**",
      "**/ieee754/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "Kitsu-${version}.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Kitsu-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
